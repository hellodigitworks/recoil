# Recoil — environment variables
#
# Copy this file to .env for local development, or paste these into
# Netlify → Site configuration → Environment variables for a deploy.
# Never commit the filled-in version. .env is gitignored.

# From your app at https://developer.whoop.com
# The client id is public; it reaches the browser so the OAuth screen can open.
WHOOP_CLIENT_ID=

# From the same app. This must never reach the browser. Only the three
# functions in netlify/functions/ read it.
WHOOP_CLIENT_SECRET=

# Optional. Netlify sets URL automatically on every deploy, and the functions
# fall back to the request's own host, so you normally leave this alone. Set it
# only if you are running somewhere that does neither, and make it match the
# redirect URI on your Whoop app exactly, with no trailing slash.
# URL=https://your-site.example.com
